#version 450
// fs_maccormack — pass 2 of MacCormack (BFECC-style) dye advection. Pass 1 is the
// existing semi-Lagrangian forward advect (dye0 → dye1, dissip 1). This pass
// reverse-advects the forward result, measures the round-trip error, and applies
// half of it as a correction — second-order accuracy, so milk filaments stay
// filaments instead of diffusing to mush in ten frames. A min/max limiter over the
// forward-sample stencil clamps the correction (no overshoot ringing).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(r32f,  set = 0, binding = 0) uniform image2D dye0;   // φⁿ (pre-advection)
layout(r32f,  set = 1, binding = 0) uniform image2D dye1;   // φ̂ⁿ⁺¹ (forward result)
layout(rg32f, set = 2, binding = 0) uniform image2D vel;
layout(r32f,  set = 3, binding = 0) uniform image2D dye_out;

layout(push_constant, std430) uniform P {
    vec2  size;
    float dt;
    float dissip;   // applied here (pass 1 runs with dissip = 1)
} p;

float samp1(ivec2 mx, vec2 pos) {
    pos = clamp(pos, vec2(0.0), vec2(mx));
    ivec2 i = ivec2(floor(pos));
    vec2 f = pos - vec2(i);
    ivec2 i1 = min(i + ivec2(1), mx);
    float d00 = imageLoad(dye1, i).r;
    float d10 = imageLoad(dye1, ivec2(i1.x, i.y)).r;
    float d01 = imageLoad(dye1, ivec2(i.x, i1.y)).r;
    float d11 = imageLoad(dye1, i1).r;
    return mix(mix(d00, d10, f.x), mix(d01, d11, f.x), f.y);
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 mx = ivec2(p.size) - ivec2(1);
    if (c.x > mx.x || c.y > mx.y) { return; }

    vec2 v = imageLoad(vel, c).rg;
    float fwd = imageLoad(dye1, c).r;
    float back = samp1(mx, vec2(c) + p.dt * v);          // reverse round trip
    float val = fwd + 0.5 * (imageLoad(dye0, c).r - back);

    // limiter: clamp to the φⁿ min/max over the forward-sample stencil
    vec2 pos = clamp(vec2(c) - p.dt * v, vec2(0.0), vec2(mx));
    ivec2 i = ivec2(floor(pos));
    ivec2 i1 = min(i + ivec2(1), mx);
    float d00 = imageLoad(dye0, i).r;
    float d10 = imageLoad(dye0, ivec2(i1.x, i.y)).r;
    float d01 = imageLoad(dye0, ivec2(i.x, i1.y)).r;
    float d11 = imageLoad(dye0, i1).r;
    float mn = min(min(d00, d10), min(d01, d11));
    float mxv = max(max(d00, d10), max(d01, d11));

    imageStore(dye_out, c, vec4(clamp(val, mn, mxv) * p.dissip, 0.0, 0.0, 0.0));
}
