#version 450
// fs_dct_1d — one separable 1D cosine transform along x or y, forward or inverse. Four
// pipelines from one source via AXIS / INVERSE defines (the same compile-time-constant
// trick fs_pressure_rbgs uses for PARITY).
//
// WHY COSINE AND NOT A COMPLEX FFT. The basis is not a performance choice, it IS the
// boundary condition — the point shaders/stamp/dct_1d.glslinc makes at length. Every pass
// in this fluid addresses neighbours with clamp(c + off, 0, mx), i.e. x(-1) = x(0): NEUMANN
// walls, zero flux. The cosine basis diagonalises exactly that operator. A complex FFT
// diagonalises the PERIODIC one, so scene 257 built on an FFT would wrap the left wall into
// the right one and show it as a seam. DCT is not the cheap option here, it is the correct
// one.
//
//   DCT-II  (forward)  X_p = Σ_i x_i cos(π(i+½)p/N)
//   DCT-III (inverse)  x_i = ( X_0 + 2 Σ_{p≥1} X_p cos(π(i+½)p/N) ) / N
//
// Exactly invertible as a pair, so W(k) = 1 in the filter really is the identity — which is
// what lets 257 claim an EXACT reference rather than a well-converged one.
//
// COST is deliberately O(N) per output, O(N²) per axis pass — the same v1 call dct_1d made.
// At 512² that is ~537 MB of reads per pass, ~5 ms for all four passes: cheaper than the
// 400-sweep Jacobi reference it replaces. It does NOT scale to 1024² (~43 ms), which is why
// 257's grid ladder stops at 512. The O(N log N) upgrade is a port of a working butterfly
// chain, not research: ../water-kit/kit/waves/shaders/fft_butterfly_{h,v}.glsl.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(r32f, set = 0, binding = 0) uniform image2D src;
layout(r32f, set = 1, binding = 0) uniform image2D dst;

layout(push_constant, std430) uniform P {
    vec2  size;
    float omega;   // unused here — the projection stage shares one push constant
    float mu;      // unused here
} pc;

const float PI = 3.14159265358979;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 mx = ivec2(pc.size) - ivec2(1);
    if (c.x > mx.x || c.y > mx.y) { return; }

    // AXIS 0 transforms along x (index i runs over columns); AXIS 1 along y.
    int n = (AXIS == 0) ? int(pc.size.x) : int(pc.size.y);
    int p = (AXIS == 0) ? c.x : c.y;

    float acc = 0.0;

    if (INVERSE == 0) {
        // DCT-II: X_p = Σ_i x_i cos(π(i+½)p/N)
        for (int i = 0; i < n; i++) {
            ivec2 s = (AXIS == 0) ? ivec2(i, c.y) : ivec2(c.x, i);
            acc += imageLoad(src, s).r * cos(PI * (float(i) + 0.5) * float(p) / float(n));
        }
    } else {
        // DCT-III: x_i = ( X_0 + 2 Σ_{p≥1} X_p cos(π(i+½)p/N) ) / N.
        // `p` is the OUTPUT index i here; the sum runs over the transform index.
        ivec2 s0 = (AXIS == 0) ? ivec2(0, c.y) : ivec2(c.x, 0);
        acc = imageLoad(src, s0).r;
        for (int k = 1; k < n; k++) {
            ivec2 s = (AXIS == 0) ? ivec2(k, c.y) : ivec2(c.x, k);
            acc += 2.0 * imageLoad(src, s).r * cos(PI * (float(p) + 0.5) * float(k) / float(n));
        }
        acc /= float(n);
    }

    imageStore(dst, c, vec4(acc, 0.0, 0.0, 0.0));
}
