#version 450
// fs_gradient_sub — subtract the pressure gradient to make the velocity divergence-free:
//     v -= 0.5 * ∇p.   In-place on the velocity field (reads own v + neighbour p).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rg32f, set = 0, binding = 0) uniform image2D vel;   // in-place
layout(r32f,  set = 1, binding = 0) uniform image2D pres;

layout(push_constant, std430) uniform P { vec2 size; vec2 pad; } pc;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 mx = ivec2(pc.size) - ivec2(1);
    if (c.x > mx.x || c.y > mx.y) { return; }

    float pR = imageLoad(pres, clamp(c + ivec2(1, 0), ivec2(0), mx)).r;
    float pL = imageLoad(pres, clamp(c + ivec2(-1, 0), ivec2(0), mx)).r;
    float pU = imageLoad(pres, clamp(c + ivec2(0, 1), ivec2(0), mx)).r;
    float pD = imageLoad(pres, clamp(c + ivec2(0, -1), ivec2(0), mx)).r;
    vec2 v = imageLoad(vel, c).rg;
    v -= 0.5 * vec2(pR - pL, pU - pD);
    // no-slip walls: kill velocity on the border ring so fluid can't smear along it
    if (c.x == 0 || c.y == 0 || c.x == mx.x || c.y == mx.y) { v = vec2(0.0); }
    imageStore(vel, c, vec4(v, 0.0, 0.0));
}
