#version 450
// w3_gradient — v -= grad(p), MASKED. This is where the free surface actually pushes.
// An air neighbour contributes p = 0 (not p_self), so a water cell just under the surface
// feels the full one-sided gradient and accelerates — that is the surface falling under
// gravity, and later the lip pitching forward. Mirroring p_self there instead would zero the
// gradient at the surface and the water would sit rigid.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(rgba32f, set = 0, binding = 0) uniform image3D vel;
layout(r32f,    set = 1, binding = 0) uniform image3D p;
layout(r32f,    set = 2, binding = 0) uniform image3D mask;

layout(push_constant, std430) uniform P { vec4 size; vec4 pad; } pc;

float sample_p(ivec3 c, ivec3 o, ivec3 mx, float self) {
    ivec3 n = clamp(c + o, ivec3(0), mx);
    float m = imageLoad(mask, n).r;
    if (m < -0.5) { return self; }        // solid -> no normal gradient
    if (m < 0.5)  { return 0.0; }         // air   -> free surface, p = 0
    return imageLoad(p, n).r;
}

void main() {
    ivec3 c = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 mx = ivec3(pc.size.xyz) - ivec3(1);
    if (c.x > mx.x || c.y > mx.y || c.z > mx.z) { return; }
    if (imageLoad(mask, c).r < 0.5) { return; }

    float self = imageLoad(p, c).r;
    vec3 g = 0.5 * vec3(
        sample_p(c, ivec3( 1, 0, 0), mx, self) - sample_p(c, ivec3(-1, 0, 0), mx, self),
        sample_p(c, ivec3( 0, 1, 0), mx, self) - sample_p(c, ivec3( 0,-1, 0), mx, self),
        sample_p(c, ivec3( 0, 0, 1), mx, self) - sample_p(c, ivec3( 0, 0,-1), mx, self));
    vec4 v = imageLoad(vel, c);
    imageStore(vel, c, vec4(v.xyz - g, 0.0));
}
