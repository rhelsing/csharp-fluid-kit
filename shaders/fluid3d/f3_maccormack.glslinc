#version 450
// f3_maccormack — pass 2 of MacCormack (BFECC) dye advection in 3D (the 3D port of
// fluid/fs_maccormack.glslinc). Pass 1 = the existing f3_advect_dye (dissip 1);
// this pass reverse-advects the forward result, applies half the round-trip error,
// and clamps to the 8-corner min/max of the forward-sample stencil (no overshoot).
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(r32f,    set = 0, binding = 0) uniform image3D dye0;   // φⁿ
layout(r32f,    set = 1, binding = 0) uniform image3D dye1;   // φ̂ⁿ⁺¹ (forward)
layout(rgba32f, set = 2, binding = 0) uniform image3D vel;
layout(r32f,    set = 3, binding = 0) uniform image3D dye_out;

layout(push_constant, std430) uniform P { vec4 size; float dt; float dissip; vec2 _pad; } p;

float samp1(ivec3 mx, vec3 pos) {
    pos = clamp(pos, vec3(0.0), vec3(mx));
    ivec3 i = ivec3(floor(pos));
    vec3 f = pos - vec3(i);
    ivec3 j = min(i + ivec3(1), mx);
    float c000 = imageLoad(dye1, ivec3(i.x, i.y, i.z)).r;
    float c100 = imageLoad(dye1, ivec3(j.x, i.y, i.z)).r;
    float c010 = imageLoad(dye1, ivec3(i.x, j.y, i.z)).r;
    float c110 = imageLoad(dye1, ivec3(j.x, j.y, i.z)).r;
    float c001 = imageLoad(dye1, ivec3(i.x, i.y, j.z)).r;
    float c101 = imageLoad(dye1, ivec3(j.x, i.y, j.z)).r;
    float c011 = imageLoad(dye1, ivec3(i.x, j.y, j.z)).r;
    float c111 = imageLoad(dye1, ivec3(j.x, j.y, j.z)).r;
    float c00 = mix(c000, c100, f.x), c10 = mix(c010, c110, f.x);
    float c01 = mix(c001, c101, f.x), c11 = mix(c011, c111, f.x);
    return mix(mix(c00, c10, f.y), mix(c01, c11, f.y), f.z);
}

void main() {
    ivec3 c = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 mx = ivec3(p.size.xyz) - ivec3(1);
    if (c.x > mx.x || c.y > mx.y || c.z > mx.z) { return; }

    vec3 v = imageLoad(vel, c).xyz;
    float fwd = imageLoad(dye1, c).r;
    float back = samp1(mx, vec3(c) + p.dt * v);
    float val = fwd + 0.5 * (imageLoad(dye0, c).r - back);

    vec3 pos = clamp(vec3(c) - p.dt * v, vec3(0.0), vec3(mx));
    ivec3 i = ivec3(floor(pos));
    ivec3 j = min(i + ivec3(1), mx);
    float mn = 1e9, mxv = -1e9;
    for (int k = 0; k < 8; k++) {
        ivec3 q = ivec3((k & 1) != 0 ? j.x : i.x, (k & 2) != 0 ? j.y : i.y, (k & 4) != 0 ? j.z : i.z);
        float d = imageLoad(dye0, q).r;
        mn = min(mn, d);
        mxv = max(mxv, d);
    }
    imageStore(dye_out, c, vec4(clamp(val, mn, mxv) * p.dissip, 0.0, 0.0, 0.0));
}
