#version 450
// f3_advect_dye — semi-Lagrangian advection of the 3D dye/density by the velocity.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(r32f,    set = 0, binding = 0) uniform image3D dye_in;
layout(rgba32f, set = 1, binding = 0) uniform image3D vel;
layout(r32f,    set = 2, binding = 0) uniform image3D dye_out;

layout(push_constant, std430) uniform P { vec4 size; float dt; float dissip; } p;

float samp(ivec3 mx, vec3 pos) {
    pos = clamp(pos, vec3(0.0), vec3(mx));
    ivec3 i = ivec3(floor(pos));
    vec3 f = pos - vec3(i);
    ivec3 j = min(i + ivec3(1), mx);
    float c000 = imageLoad(dye_in, ivec3(i.x, i.y, i.z)).r;
    float c100 = imageLoad(dye_in, ivec3(j.x, i.y, i.z)).r;
    float c010 = imageLoad(dye_in, ivec3(i.x, j.y, i.z)).r;
    float c110 = imageLoad(dye_in, ivec3(j.x, j.y, i.z)).r;
    float c001 = imageLoad(dye_in, ivec3(i.x, i.y, j.z)).r;
    float c101 = imageLoad(dye_in, ivec3(j.x, i.y, j.z)).r;
    float c011 = imageLoad(dye_in, ivec3(i.x, j.y, j.z)).r;
    float c111 = imageLoad(dye_in, ivec3(j.x, j.y, j.z)).r;
    float c00 = mix(c000, c100, f.x), c10 = mix(c010, c110, f.x);
    float c01 = mix(c001, c101, f.x), c11 = mix(c011, c111, f.x);
    return mix(mix(c00, c10, f.y), mix(c01, c11, f.y), f.z);
}

void main() {
    ivec3 c = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 mx = ivec3(p.size.xyz) - ivec3(1);
    if (c.x > mx.x || c.y > mx.y || c.z > mx.z) { return; }
    vec3 v = imageLoad(vel, c).xyz;
    imageStore(dye_out, c, vec4(samp(mx, vec3(c) - p.dt * v) * p.dissip, 0.0, 0.0, 0.0));
}
