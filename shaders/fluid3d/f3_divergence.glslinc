#version 450
// f3_divergence — div = ∂vx/∂x + ∂vy/∂y + ∂vz/∂z (central differences).
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(rgba32f, set = 0, binding = 0) uniform image3D vel;
layout(r32f,    set = 1, binding = 0) uniform image3D div;

layout(push_constant, std430) uniform P { vec4 size; vec4 pad; } p;

void main() {
    ivec3 c = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 mx = ivec3(p.size.xyz) - ivec3(1);
    if (c.x > mx.x || c.y > mx.y || c.z > mx.z) { return; }
    float xR = imageLoad(vel, clamp(c + ivec3(1, 0, 0), ivec3(0), mx)).x;
    float xL = imageLoad(vel, clamp(c + ivec3(-1, 0, 0), ivec3(0), mx)).x;
    float yU = imageLoad(vel, clamp(c + ivec3(0, 1, 0), ivec3(0), mx)).y;
    float yD = imageLoad(vel, clamp(c + ivec3(0, -1, 0), ivec3(0), mx)).y;
    float zF = imageLoad(vel, clamp(c + ivec3(0, 0, 1), ivec3(0), mx)).z;
    float zB = imageLoad(vel, clamp(c + ivec3(0, 0, -1), ivec3(0), mx)).z;
    imageStore(div, c, vec4(0.5 * ((xR - xL) + (yU - yD) + (zF - zB)), 0.0, 0.0, 0.0));
}
