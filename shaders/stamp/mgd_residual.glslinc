// mgd_residual.glslinc — r = rhs − A_L u at level L, STAMP-GENERIC.
//
// Fork of mg_residual.glslinc for MgDeepSolver (solver-ledger.md §7a); mg_residual is
// left alone for MgvSolver. Same one-line difference as mgd_smooth: the operator is
// st_diag / st_conductance instead of a scalar pc.beta.
//
// MUST use the identical operator to mgd_smooth. If these two ever disagree the V-cycle
// does not just converge slowly — it converges to the wrong answer while the residual
// readout (which is computed from THIS file, via the coarse-grid correction) looks fine.
//
// Sets: u_in = 2, r_out = 3, rhs_img = 4 (host header). Stamp supplies h_curr/h_prev/pc.

void main() {
    ST_IVEC c = ST_CELL();
    if (ST_OOB(c)) {
        return;
    }

    float u = imageLoad(u_in, c).r;
    float au = st_diag(c) * u;
    for (int k = 0; k < ST_NB; k++) {
        ST_IVEC n = ST_NEIGHBOUR(c, k);
        au -= st_conductance(c, n) * imageLoad(u_in, n).r;
    }
    imageStore(u_out, c, vec4(imageLoad(rhs_img, c).r - au, 0.0, 0.0, 0.0));
}
