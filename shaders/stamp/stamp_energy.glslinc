#version 450
// stamp_energy — |h − h_prev|, the ringing energy of a wave field, into a display texture.
// Scenes 258/259's artifact view.
//
// A dissipative scheme's artifact is not a spatial residual you can point at — it is a
// DECAY RATE. So the honest thing to render is what is decaying: ∂h/∂t, which the stamp
// solver already carries as two levels (HeightRid and PrevRid). Where this is bright, the
// plate is still moving; where it has gone dark, backward-Euler ate the tail.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(r32f, set = 0, binding = 0) uniform image2D in0;   // h_curr
layout(r32f, set = 1, binding = 0) uniform image2D in1;   // h_prev
layout(r32f, set = 2, binding = 0) uniform image2D out_e;

layout(push_constant, std430) uniform P { vec2 size; float gain; float _pad; } pc;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 mx = ivec2(pc.size) - ivec2(1);
    if (c.x > mx.x || c.y > mx.y) { return; }
    float d = imageLoad(in0, c).r - imageLoad(in1, c).r;
    imageStore(out_e, c, vec4(abs(d) * pc.gain, 0.0, 0.0, 0.0));
}
