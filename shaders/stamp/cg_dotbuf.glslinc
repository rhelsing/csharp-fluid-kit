// cg_dotbuf — full GPU dot product Σ a·b written to a SCALAR-BUFFER slot (no CPU
// readback). One workgroup of 256 threads grid-strides the whole field, then a
// shared-memory tree reduces to a single value → sc[slot].
//
// Single-workgroup on purpose HERE: MgvSolver and MgDeepSolver call it once per measure
// tick, where its cost is irrelevant. CG's hot path uses the two-stage cg_dot_partial +
// cg_dot_final instead — see the note in GpuStampSolver.
//
// DIMENSION-GENERIC (solver-ledger.md §7d). Elementwise, so ST_TOTAL / ST_FROM_LINEAR is all
// the topology it needs; `#version`, local_size, images and push constant come from the host.
//
// Host must supply, before this body: #version, local_size_x = 256, the two r32f images
// (a_img @ set 2, b_img @ set 3), the Scalars SSBO @ set 5, and a push constant named `pc`
// whose FIRST member is the extent (vec2 in 2D, vec4 in 3D) followed by `uint slot`.

shared float sdata[256];

void main() {
    uint total = ST_TOTAL();
    uint li = gl_LocalInvocationIndex;

    float acc = 0.0;
    for (uint t = li; t < total; t += 256u) {
        ST_IVEC c = ST_FROM_LINEAR(t);
        acc += imageLoad(a_img, c).r * imageLoad(b_img, c).r;
    }
    sdata[li] = acc;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (li < s) {
            sdata[li] += sdata[li + s];
        }
        barrier();
    }
    if (li == 0u) {
        sc[pc.slot] = sdata[0];
    }
}
