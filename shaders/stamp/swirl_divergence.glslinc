#version 450

// swirl_divergence.glslinc — foam v3b: central-difference divergence of the swirl
// velocity (toroidal neighbours), input to the pressure solve.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rg16f, set = 0, binding = 0) uniform image2D vel_in;
layout(r16f, set = 1, binding = 0) uniform image2D div_out;

layout(push_constant, std430) uniform Params {
    vec2 size;
    vec2 _pad;
} pc;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 N = ivec2(pc.size);
    if (c.x >= N.x || c.y >= N.y) {
        return;
    }
    float vR = imageLoad(vel_in, ((c + ivec2(1, 0)) % N + N) % N).r;
    float vL = imageLoad(vel_in, ((c + ivec2(-1, 0)) % N + N) % N).r;
    float vU = imageLoad(vel_in, ((c + ivec2(0, 1)) % N + N) % N).g;
    float vD = imageLoad(vel_in, ((c + ivec2(0, -1)) % N + N) % N).g;
    imageStore(div_out, c, vec4(0.5 * (vR - vL + vU - vD), 0.0, 0.0, 0.0));
}
