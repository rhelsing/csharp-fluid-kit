#version 450
// cg_dot_final — stage 2 of the two-stage dot product: one workgroup folds the partials
// written by cg_dot_partial into a single scalar slot.
//
// This stage IS single-workgroup, and that is fine: it reduces `count` partials (256 by
// default), not the whole field. One iteration per thread instead of 4,096.
//
// It stays on the GPU rather than summing on the host because CG's entire design is one
// barrier-chained compute list with no per-iteration readback — a CPU fold here would
// reintroduce a stall per dot product, three times per iteration, which is exactly the cost
// the design was built to avoid.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 4, binding = 0) buffer Partials { float partial[]; };
layout(std430, set = 5, binding = 0) buffer Scalars { float sc[]; };

layout(push_constant, std430) uniform P {
    uint count;   // number of partials written by stage 1
    uint slot;    // destination scalar slot
    uint _p0;
    uint _p1;
} pc;

shared float sdata[256];

void main() {
    uint li = gl_LocalInvocationIndex;

    float acc = 0.0;
    for (uint t = li; t < pc.count; t += 256u) {
        acc += partial[t];
    }

    sdata[li] = acc;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (li < s) {
            sdata[li] += sdata[li + s];
        }
        barrier();
    }
    if (li == 0u) {
        sc[pc.slot] = sdata[0];
    }
}
