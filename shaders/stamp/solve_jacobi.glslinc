// solve_jacobi.glslinc — one matrix-free Jacobi relaxation of the stamped system:
//     x(c) = ( st_rhs(c) + Σ st_conductance(c,n)·x_in(n) ) / st_diag(c)
//
// Generic over ANY stamp that defines st_diag / st_conductance / st_rhs and a push
// constant `pc` starting with `vec2 size`. The solver header supplies iter_in (set 2)
// and iter_out (set 3). clamp() on neighbours = Neumann (reflective) walls.

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 mx = ivec2(pc.size) - ivec2(1);
    if (c.x > mx.x || c.y > mx.y) {
        return;
    }

    const ivec2 offs[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
    float acc = st_rhs(c);
    for (int k = 0; k < 4; k++) {
        ivec2 n = clamp(c + offs[k], ivec2(0), mx);
        acc += st_conductance(c, n) * imageLoad(iter_in, n).r;
    }
    imageStore(iter_out, c, vec4(acc / st_diag(c), 0.0, 0.0, 0.0));
}
